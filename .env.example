PORT=3000
NLP_SERVICE_URL=http://localhost:8000
NLP_TIMEOUT_MS=20000

# Required Postgres database. Use local Postgres, Supabase, Neon, Render Postgres, etc.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/palabra_clara
DATABASE_SSL=true
# Optional: set to "true" to enforce TLS certificate validation when DATABASE_SSL is on
# (default keeps rejectUnauthorized: false for compatibility with self-signed hosts).
DATABASE_SSL_REJECT_UNAUTHORIZED=

# Translation provider: ai (default, uses the AI provider below) or google.
TRANSLATION_PROVIDER=ai
GOOGLE_TRANSLATE_API_KEY=

# Text-to-Speech provider. Browser Web Speech is used when Google TTS is not configured.
# Fallback order: GOOGLE_TTS_API_KEY, then GOOGLE_CLOUD_API_KEY, then GOOGLE_TRANSLATE_API_KEY.
GOOGLE_TTS_API_KEY=
# Optional: shared Google Cloud API key, used as a GOOGLE_TTS_API_KEY fallback.
GOOGLE_CLOUD_API_KEY=

# AI provider: groq or openai. Groq is OpenAI-compatible and is the default.
AI_PROVIDER=groq
GROQ_API_KEY=
AI_API_KEY=
AI_API_URL=
AI_MODEL=llama-3.1-8b-instant
# Optional: used as an AI_API_KEY fallback when AI_PROVIDER is not groq.
OPENAI_API_KEY=
