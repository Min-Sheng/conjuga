PORT=3000
NLP_SERVICE_URL=http://localhost:8000
NLP_TIMEOUT_MS=20000

# Required Postgres database. Use local Postgres, Supabase, Neon, Render Postgres, etc.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/palabra_clara
DATABASE_SSL=true

# Translation provider: mymemory or google
TRANSLATION_PROVIDER=mymemory
MYMEMORY_EMAIL=
GOOGLE_TRANSLATE_API_KEY=

# Text-to-Speech provider. Browser Web Speech is used when Google TTS is not configured.
GOOGLE_TTS_API_KEY=

# AI provider: groq or openai. Groq is OpenAI-compatible and is the default.
AI_PROVIDER=groq
GROQ_API_KEY=
AI_API_KEY=
AI_API_URL=
AI_MODEL=llama-3.1-8b-instant
